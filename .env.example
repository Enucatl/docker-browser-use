# Shared homelab env (`DOCKER_DOMAIN`, etc.) lives in `/opt/docker/.env`.
#
# Important: `COMPOSE_ENV_FILES` must be set in the *shell / systemd environment*
# before Compose starts. Listing it only inside this file does NOT load `../.env`
# for `${DOCKER_DOMAIN}` interpolation in docker-compose.yml (Compose v2/v5).
#
# Preferred (matches other stacks / puppet units):
#   export COMPOSE_ENV_FILES=../.env,./.env
# Or one-shot:
#   docker compose --env-file ../.env --env-file .env up -d
#
# Fallback so bare `docker compose up` still interpolates hosts:
DOCKER_DOMAIN=docker.home.arpa

TZ=Europe/Zurich

# Public hostname is browser-use.${DOCKER_DOMAIN} (Traefik + Authelia).
# Authelia's wildcard *.docker.home.arpa rule already allows group:admins;
# do not edit /opt/docker/authelia unless a custom policy is required.
BROWSER_USE_HOST=browser-use.${DOCKER_DOMAIN}

# Postgres (internal network only; password via ./secrets/postgres_password).
DATABASE_NAME=browser_use
DATABASE_USER=browser_use
# DATABASE_HOST / DATABASE_PORT / DATABASE_PASSWORD_FILE are set in compose.

# Chromium CDP (browser service; internal Compose network only — never host-publish).
CDP_PORT=9222
BROWSER_CDP_URL=http://browser:9222
BROWSER_PROFILE_NAME=default
CHROME_USER_DATA_DIR=/data/chrome-profile
CHROME_DOWNLOAD_DIR=/data/downloads
BROWSER_IDLE_TTL_SECONDS=300
# Set true only if the controller can run `docker compose` (e.g. docker.sock mount).
BROWSER_COMPOSE_CONTROL=false
BROWSER_STOP_ON_IDLE=false

# Live view (T022): Xvfb + internal x11vnc; Authelia-gated noVNC at /vnc/.
# Never host-publish VNC_PORT. VNC_VIEW_ONLY=true (default) is watch-only;
# take-control mutex is separate (docs/takeover.md).
# DISPLAY=:99
# VNC_PORT=5900
# VNC_VIEW_ONLY=true

# Jev Decision API (T014/T015). Without a key the controller uses FakeJevClient
# (immediate DONE) — enough for UI/audit smoke, not real browsing decisions.
# Prefer JEV_API_KEY_FILE=/run/secrets/... in Compose (never commit keys).
# Real credentials + browser egress are required for live page goals; see
# docs/operator.md § Known limitations.
# JEV_BASE_URL=https://jevtypesafeai.com/api
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_SECONDS=30
# JEV_API_KEY_FILE=/run/secrets/jev_api_key

# Optional small text LLM for TYPE_TEXT fills (T016). OpenAI-compatible API.
# Prefer TEXT_LLM_API_KEY_FILE=/run/secrets/... in Compose (never commit keys).
# TEXT_LLM_BASE_URL=https://openrouter.ai/api/v1
# TEXT_LLM_MODEL=gpt-4.1-mini
# TEXT_LLM_MAX_TOKENS=64
# TEXT_LLM_API_KEY_FILE=/run/secrets/text_llm_api_key

# Image build version tag (optional).
# VERSION=0.0.0

# Auth (T012). Compose production sets AUTH_REQUIRED=true on the controller.
# Leave unset/false for local pytest and bare uvicorn (anonymous / dev header).
# Never set AUTH_REQUIRED=false in docker-compose.yml production env.
# AUTH_REQUIRED=false
#
# Host/CSRF defaults derive from BROWSER_USE_HOST when unset:
# ALLOWED_HOSTS=browser-use.${DOCKER_DOMAIN},localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://browser-use.${DOCKER_DOMAIN}
# Spoofing model and local bypass: docs/auth.md
