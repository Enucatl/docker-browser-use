# Chromium worker image for Browser Use CDP + Xvfb/x11vnc.
# Keep this image free of app Python code; the controller talks to CDP over Compose DNS.
# Raw VNC (5900) stays un-published; Authelia-gated noVNC is a sibling service.
FROM debian:bookworm-slim

ARG BITWARDEN_EXTENSION_VERSION=2026.8.0
ARG BITWARDEN_EXTENSION_SHA256=d1a5942d9c234d03382da99279932055064caae7a32cc9b157940c863165d59f

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        chromium \
        chromium-sandbox \
        curl \
        fonts-liberation \
        fonts-noto-color-emoji \
        fonts-noto-core \
        nginx-light \
        tini \
        x11vnc \
        xvfb \
    && rm -rf /var/lib/apt/lists/*

# Install the official Bitwarden Web Store CRX as a Chromium external extension.
# The pinned digest makes image rebuilds fail instead of silently changing it.
RUN mkdir -p /opt/bitwarden /usr/lib/chromium/extensions \
    && curl -fsSL \
        'https://clients2.google.com/service/update2/crx?response=redirect&prodversion=150.0.7871.100&acceptformat=crx3&x=id%3Dnngceckbapebfimnlniiiahkandclblb%26uc' \
        -o /opt/bitwarden/bitwarden.crx \
    && echo "${BITWARDEN_EXTENSION_SHA256}  /opt/bitwarden/bitwarden.crx" | sha256sum -c - \
    && printf '{"nngceckbapebfimnlniiiahkandclblb":{"external_crx":"/opt/bitwarden/bitwarden.crx","external_version":"%s"}}\n' \
        "${BITWARDEN_EXTENSION_VERSION}" \
        > /usr/lib/chromium/extensions/external_extensions.json \
    && chmod 644 /opt/bitwarden/bitwarden.crx \
        /usr/lib/chromium/extensions/external_extensions.json

# Non-root UID matches the chrome_profile volume owner used in compose.
RUN groupadd --system --gid 1000 browser \
    && useradd --system --uid 1000 --gid browser \
        --create-home --home-dir /home/browser browser \
    && mkdir -p /data/chrome-profile /data/downloads /tmp/chromium \
    && chown -R browser:browser /data /home/browser /tmp/chromium

ENV HOME=/home/browser \
    CHROME_USER_DATA_DIR=/data/chrome-profile \
    CHROME_DOWNLOAD_DIR=/data/downloads \
    CDP_PORT=9222 \
    CDP_LOOPBACK_PORT=9223 \
    DISPLAY=:99 \
    VNC_PORT=5900 \
    VNC_VIEW_ONLY=true \
    CHROMIUM_FLAGS="--disable-gpu --disable-dev-shm-usage"

COPY scripts/browser-entrypoint.sh /usr/local/bin/browser-entrypoint.sh
COPY scripts/cdp-nginx.conf /etc/chromium-cdp-nginx.conf
RUN chmod 755 /usr/local/bin/browser-entrypoint.sh \
    && chown browser:browser /etc/chromium-cdp-nginx.conf

USER browser
WORKDIR /home/browser

# CDP and VNC stay un-published; controller/noVNC use the internal default network.
EXPOSE 9222 5900

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
    CMD ["curl", "-sf", "http://127.0.0.1:9222/json/version"]

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/browser-entrypoint.sh"]
CMD ["chromium"]
